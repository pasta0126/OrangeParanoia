@page "/utility"
@using OrangeParanoia.Services.Interfaces
@inject IUtilityService UtilityService
@inject IDateService DateService
@inject INumberService NumberService

<h3>Demo Utility 📊</h3>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="GetHexColor">HexColor</button>
    <span>@HexColor</span>
</div>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="GetHexColor2">HexColor2</button>
    <span>@HexColor2</span>
</div>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="GetRgbColor">RgbColor</button>
    <span>@RgbColor</span>
</div>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="GetRgba">Rgba</button>
    <span>@RgbaColor</span>
</div>

@code {
    string HexColor;
    string HexColor2;
    string RgbColor;
    string RgbaColor;

    double GetAlpha() => (double)NumberService.GetRandomDecimalInRange(null, null, null);
    string GetDemoInput() => DateService.GetRandomTime();

    void GetHexColor() => HexColor = UtilityService.GetHexColor(GetDemoInput());

    void GetHexColor2() => HexColor2 = UtilityService.GetHexColor2(GetDemoInput());

    void GetRgbColor() => RgbColor = UtilityService.GetRgbColor(GetDemoInput());

    void GetRgba() => RgbaColor = UtilityService.GetRgbaColor(GetDemoInput(), GetAlpha());
}
