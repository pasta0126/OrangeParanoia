@page "/answer"
@using OrangeParanoia.Services.Interfaces
@inject IAnswerService AnswerService

<h3>Demo Answers 🎲</h3>

<div class="mb-3">
    <button class="btn btn-success me-2" @onclick="GetMagic8Ball">Magic 8-Ball</button>
    <span>@Magic8Ball</span>
</div>

<div class="mb-3">
    <button class="btn btn-success me-2" @onclick="GetYesNo">Yes / No</button>
    <span>@YesNo</span>
</div>

<div class="mb-3">
    <button class="btn btn-success me-2" @onclick="GetTrueFalse">True / False</button>
    <span>@TrueFalse</span>
</div>

@code {
    string Magic8Ball;
    string YesNo;
    string TrueFalse;

    void GetMagic8Ball() =>
        Magic8Ball = AnswerService.GetMagic8BallAnswer();

    void GetYesNo() =>
        YesNo = AnswerService.GetYesNoAnswer();

    void GetTrueFalse() =>
        TrueFalse = AnswerService.GetTrueFalseAnswer();
}
